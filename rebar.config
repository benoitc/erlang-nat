{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard
]}.

{deps, [
    {hackney, "1.23.0"},
    {inet_ext, "1.0.0"},
    {meck, "0.9.2"}
]}.

{minimum_otp_vsn, "26"}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {extras, [
        {<<"README.md">>, #{title => <<"Overview">>}},
        {<<"LICENSE">>, #{title => <<"License">>}}
    ]},
    {main, <<"README.md">>},
    {homepage_url, <<"https://benoitc.github.io/erlang-nat/">>},
    {source_url, <<"https://github.com/benoitc/erlang-nat">>},
    {api_reference, false}
]}.

{dialyzer, [
    {plt_extra_apps, [meck]}
]}.

{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/logs"}]}}
]}.

{profiles, [
    {test, [{deps, [{meck, "0.9.2"}]}]},
    {docs, [{deps,
                     [
                      {edown,
                       {git, "https://github.com/uwiger/edown.git",
                        {tag, "0.8.1"}}}
                     ]},

                    {edoc_opts, [{doclet, edown_doclet},
                                 {packages, false},
                                 {subpackages, true},
                                 {top_level_readme,
                                  {"./README.md", "https://github.com/benoitc/erlang-nat"}}]}]}
           ]}.

