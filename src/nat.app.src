{application, nat, [
	{description, "implements NAT handling facilities"},
	{vsn, "0.5.0"},
	{modules, []},
	{registered, [nat_server]},
	{applications, [kernel,stdlib,inet_cidr,inet_ext,hackney,xmerl]},
	{mod, {nat_app, []}},
  {licenses, ["MIT"]},
  {links, [{"Github", "https://github.com/benoitc/erlang-nat"}]},
  {files, ["scripts", "src", "LICENSE", "NOTICE", "README.md", "rebar.config", "rebar.lock"]}
]}.
