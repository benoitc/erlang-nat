{application, nat, [
	{description, "NAT traversal library for Erlang - UPnP IGD, NAT-PMP, PCP"},
	{vsn, "0.5.0"},
	{modules, []},
	{registered, [nat_server]},
	{applications, [kernel, stdlib, inet_cidr, inet_ext, hackney, xmerl]},
	{mod, {nat_app, []}},
	{licenses, ["MIT"]},
	{links, #{
		<<"Homepage">> => <<"https://benoitc.github.io/erlang-nat/">>,
		<<"GitHub">> => <<"https://github.com/benoitc/erlang-nat">>,
		<<"Sponsor">> => <<"https://github.com/sponsors/benoitc">>
	}},
	{files, ["src", "include", "LICENSE", "README.md", "rebar.config"]}
]}.
